# Elasticsearch (same cluster as media-monitoring-svc)
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USERNAME=your_es_username
ELASTICSEARCH_PASSWORD=your_es_password
ELASTICSEARCH_INDEX=online-news-*

# Pipeline
BATCH_SIZE=8           # 8 di box 4 vCPU; 4 kalau cuma 2 vCPU
IDLE_SLEEP=60          # seconds to wait when nothing is un-annotated
SORT_FIELD=scraped_at  # newest first by this field
NER_MIN_SCORE=0.8
MAX_CHARS=2500         # ~512 tokens; more only costs tokenizer time

# Models / runtime (see service/loader.py)
EMOTION_MODEL=w11wo/indonesian-roberta-base-prdect-id
SENTIMENT_MODEL=masnasri-a/indobert-sentiment-analysis
NER_MODEL=cahya/bert-base-indonesian-NER
NER_ENABLED=1
TORCH_THREADS=4   # = jumlah vCPU
QUANTIZE=1        # butuh AVX2; loader mengabaikannya kalau tidak ada
MAX_LENGTH=512
